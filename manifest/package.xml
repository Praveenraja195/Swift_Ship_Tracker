<?xml version="1.0" encoding="UTF-8"?>
<!--
  package.xml for retrieving SwiftShip Tracker metadata from a Developer Edition org.
  Copy this file to  manifest/package.xml  inside your SFDX project, then run:
      sf project retrieve start --manifest manifest/package.xml
  Names below come from the project documentation. If a retrieve warns that a
  name was not found, check the real API name with:
      sf org list metadata --metadata-type <Type>
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">

    <!-- Custom objects, fields, list views, validation rules, record types -->
    <types>
        <members>Parcel__c</members>
        <members>Delivery__c</members>
        <members>Sender__c</members>
        <members>Receiver__c</members>
        <name>CustomObject</name>
    </types>

    <!-- Tabs created for the custom objects -->
    <types>
        <members>Parcel__c</members>
        <members>Delivery__c</members>
        <members>Sender__c</members>
        <members>Receiver__c</members>
        <name>CustomTab</name>
    </types>

    <!-- All flows: Parcel Details, record-triggered, scheduled, etc. -->
    <types>
        <members>*</members>
        <name>Flow</name>
    </types>

    <!-- Prompt Builder template: Retrieve Parcel Details -->
    <types>
        <members>*</members>
        <name>GenAiPromptTemplate</name>
    </types>

    <!-- Agentforce agent definition (SwiftShip Tracker agent) -->
    <types>
        <members>*</members>
        <name>Bot</name>
    </types>
    <types>
        <members>*</members>
        <name>BotVersion</name>
    </types>

    <!-- Agentforce planner, topics (subagents) and actions -->
    <types>
        <members>*</members>
        <name>GenAiPlannerBundle</name>
    </types>
    <types>
        <members>*</members>
        <name>GenAiPlugin</name>
    </types>
    <types>
        <members>*</members>
        <name>GenAiFunction</name>
    </types>

    <!-- Apex classes and triggers (Batch Apex, parcel automation) -->
    <types>
        <members>*</members>
        <name>ApexClass</name>
    </types>
    <types>
        <members>*</members>
        <name>ApexTrigger</name>
    </types>

    <!-- Security: Swift Ship permission set -->
    <types>
        <members>*</members>
        <name>PermissionSet</name>
    </types>

    <!-- Lightning app and record/app pages -->
    <types>
        <members>*</members>
        <name>CustomApplication</name>
    </types>
    <types>
        <members>*</members>
        <name>FlexiPage</name>
    </types>

    <!-- Email alerts and templates used for notifications -->
    <types>
        <members>*</members>
        <name>EmailTemplate</name>
    </types>
    <types>
        <members>*</members>
        <name>Workflow</name>
    </types>

    <!-- Approval processes -->
    <types>
        <members>*</members>
        <name>ApprovalProcess</name>
    </types>

    <!-- Reports and dashboards: wildcard only returns unfiled public ones.
         For a custom folder, add its name and then Folder/ReportName entries. -->
    <types>
        <members>*</members>
        <name>Report</name>
    </types>
    <types>
        <members>*</members>
        <name>Dashboard</name>
    </types>

    <version>67.0</version>
</Package>
